  "keyFeatures": [
    "Multi-user, multi-agent architecture with per-user agent isolation",
    "16 MBTI persona templates plus custom system prompts",
    "IM channel integrations: Feishu, DingTalk, QQ, Discord, WeCom",
    "ACP (Agent Client Protocol) for bidirectional IDE integration",
    "Connector ecosystem with OAuth and MCP gateway support",
    "Browser automation and remote desktop via headless Chromium",
    "Scheduled cron jobs with natural-language triggers",
    "Pluggable LLM providers: OpenAI-compatible, DashScope, Ollama",
    "Self-hosted with all data stored locally under ~/.octop/",
    "Single-command startup with system service registration"
  ],
  "publicApiSurface": [
    "POST /api/auth/login",
    "GET /api/auth/me",
    "GET /api/agents",
    "POST /api/agents",
    "POST /api/agents/{id}/start",
